<!DOCTYPE html>
<html lang="pl">
<%- include('partials/head', { title: 'Materiały FTP' }) %>
<body>
    <div class="layout-wrapper" style="display: flex; min-height: 100vh;">
        <%- include('partials/sidebar', { active: 'ftp', isAdmin }) %>
        
        <main class="content-area" style="flex: 1; padding: 2rem; overflow-y: auto;">
            <%- include('partials/topbar', { title: 'Eksplorator Materiałów', isAdmin }) %>
            
            <section class="view-section active">
                <div class="ftp-container glassmorphism">
                    <div class="ftp-header">
                        <h2 class="section-title"><i class="gg-folder"></i> Pliki na serwerze</h2>
                        <div class="ftp-actions">
                            <% if (isAdmin) { %>
                                <input type="file" id="file-upload" style="display: none;" />
                                <button class="btn-primary" id="upload-btn"><i class="gg-software-upload"></i> Upload</button>
                            <% } %>
                        </div>
                    </div>
                    
                    <div class="table-responsive">
                        <table class="ftp-table">
                            <thead>
                                <tr>
                                    <th>Name <i class="gg-arrows-v"></i></th>
                                    <th>Last Modified <i class="gg-arrows-v"></i></th>
                                    <th>Size <i class="gg-arrows-v"></i></th>
                                </tr>
                            </thead>
                            <tbody id="ftp-tbody">
                                <!-- Generated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <% if (!isAdmin) { %>
        <%- include('partials/modal') %>
    <% } %>

    <script src="/js/script.js"></script>
    
</body>
</html>
