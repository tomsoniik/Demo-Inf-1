<aside class="sidebar glassmorphism" style="position: relative;">
    <div id="sidebar-toggle" style="position: absolute; right: 0; top: 0; bottom: 0; width: 6px; background: rgba(255,255,255,0.02); cursor: pointer; transition: background 0.2s; z-index: 10;"></div>
    <div class="logo" style="padding: 1.5rem; text-align: center; border-bottom: 1px solid rgba(255,255,255,0.1); white-space: nowrap; overflow: hidden;">
        <i class="gg-server"></i>
        <span class="sidebar-text">Dariusz Baj</span>
    </div>
    <nav class="sidebar-nav" style="padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem;">
        <a href="/" class="sidebar-link <%= active === 'home' ? 'active' : '' %>" title="Strona Główna">
            <i class="gg-home"></i> <span class="sidebar-text">Strona Główna</span>
        </a>
        <a href="/ftp" class="sidebar-link <%= active === 'ftp' ? 'active' : '' %>" title="Eksplorator FTP">
            <i class="gg-folder"></i> <span class="sidebar-text">Eksplorator FTP</span>
        </a>
        <% if (isAdmin) { %>
            <a href="/admin" class="sidebar-link <%= active === 'admin' ? 'active' : '' %>" style="color: var(--primary);" title="Panel Admina">
                <i class="gg-shield"></i> <span class="sidebar-text">Panel Admina</span>
            </a>
        <% } %>
    </nav>
</aside>
