<div class="modal-overlay" id="login-modal">
    <div class="modal-content glassmorphism">
        <div class="modal-header">
            <h2>Logowanie do panelu</h2>
            <button class="close-modal" id="close-login"><i class="gg-close"></i></button>
        </div>
        <form id="login-form">
            <div class="input-group">
                <label>Login</label>
                <input type="text" id="login-input" placeholder="Wprowadź swój login" required>
            </div>
            <div class="input-group">
                <label>Hasło</label>
                <input type="password" id="password-input" placeholder="Wprowadź hasło" required>
            </div>
            <button type="submit" class="btn-primary" style="width: 100%; margin-top: 1rem;">
                Zaloguj się
            </button>
        </form>
    </div>
</div>
